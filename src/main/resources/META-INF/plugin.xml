<idea-plugin>
    <id>com.github.mahdibuilds.jetbrainsidecleaner</id>
    <name>ClearIDE: Leftover Version Remover</name>
    <vendor>Mehedi H Faysal</vendor>
    <depends>com.intellij.modules.platform</depends>

    <actions>
        <action id="ClearIDE.RunSweeper" class="com.github.mahdibuilds.jetbrainsidecleaner.ClearIDEAction" text="Clean Up Old IDE Data" description="Scan and safely remove leftover JetBrains directories">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
